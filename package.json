{
  "name": "pdf-to-audiobook",
  "version": "1.0.0",
  "description": "Convert PDF documents to high-quality audiobooks using Kokoro TTS",
  "main": "out/main/index.js",
  "author": "Inner Ninja",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.1.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "6.0.2",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "com.innerninja.pdf-to-audiobook",
    "productName": "PDF to Audiobook",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "PDF_to_Audiobook.py",
      "Queue.py",
      "QueueService.py",
      "pyproject.toml",
      "ffmpeg/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}
