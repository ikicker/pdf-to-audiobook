{
  "name": "pdf-to-audiobook",
  "desktopName": "com.ikicker.pdf-to-audiobook",
  "version": "2.0.0",
  "description": "Convert PDF documents to high-quality audiobooks using Kokoro TTS",
  "main": "out/main/index.js",
  "author": "Inner Ninja",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:python1": "NLTK_DISABLE_IMPORT_SECURITY=1 audiobook_env/bin/pyinstaller --onedir PDF_to_Audiobook.py && electron-builder",
    "preview": "electron-vite preview",
    "package": "NLTK_DISABLE_IMPORT_SECURITY=1 audiobook_env/bin/pyinstaller --onedir PDF_to_Audiobook.py && electron-vite build && electron-builder",
    "package:win": "NLTK_DISABLE_IMPORT_SECURITY=1 audiobook_env/Scripts/pyinstaller --onedir PDF_to_Audiobook.py && electron-vite build && electron-builder --win",
    "package:mac": "NLTK_DISABLE_IMPORT_SECURITY=1 audiobook_env/bin/pyinstaller --onedir PDF_to_Audiobook.py && electron-vite build && electron-builder --mac",
    "package:linux": "NLTK_DISABLE_IMPORT_SECURITY=1 audiobook_env/bin/pyinstaller --onedir PDF_to_Audiobook.py && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.innerninja.pdf-to-audiobook",
    "productName": "PDF to Audiobook",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "PDF_to_Audiobook.py",
      "pyproject.toml",
      "audiobook_env/**/*"
    ],
    "asarUnpack": [
      "ffmpeg/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "frm_Main/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "frm_Main/favicon.png",
      "category": "Utility",
      "maintainer": "Inner Ninja <your-email@example.com>"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "include": "frm_Main/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PDF to AudioBook"
    },
    "extraResources": [
      {
        "from": "audiobook_env",
        "to": "audiobook_env",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "PDF_to_Audiobook.py",
        "to": "PDF_to_Audiobook.py"
      },
      {
        "from": "dist/PDF_to_Audiobook", 
        "to": "PDF_to_Audiobook" 
      },
      {
        "from": "pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
